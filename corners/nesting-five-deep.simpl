(* Part 1: nesting has no limit, and the innermost body reaches every name
   enclosing it. valid/nested-functions.simpl stops at three levels. *)
program deep

integer level;

define l1(integer a) -> integer
begin
    integer x1;

    define l2(integer b) -> integer
    begin
        integer x2;

        define l3(integer c) -> integer
        begin
            integer x3;

            define l4(integer d) -> integer
            begin
                integer x4;

                define l5(integer e) -> integer
                begin
                    exit level + a + b + c + d + e + x1 + x2 + x3 + x4
                end

                x4 <- d;
                exit l5(d)
            end

            x3 <- c;
            exit l4(c)
        end

        x2 <- b;
        exit l3(b)
    end

    x1 <- a;
    exit l2(a)
end

begin
    level <- 1;
    write l1(2)
end
