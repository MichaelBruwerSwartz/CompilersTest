(* The value assigned must have the type of the location assigned to. *)
program assignment

define f() -> integer
begin
    exit 1
end

begin
    integer i;
    boolean b;
    integer array a;
    boolean array c;

    a <- array 2;
    c <- array 2;

    i <- true;
    b <- 1;
    i <- a;
    a <- i;
    a <- c;
    a[0] <- true;
    c[0] <- 1;
    i <- f;
    f <- 1;
    assignment <- 1;
    a <- a;
    i <- f()
end
